{# Critical CSS inline — стили первого экрана, не блокируют FCP #}
{% set criticalCssContent = inlineCss('critical.min.css') %}
{% if criticalCssContent %}
<style>{{ criticalCssContent|raw }}</style>
{% endif %}

{# Main CSS — async загрузка через media hack (не блокирует рендеринг) #}
<link rel="stylesheet" href="{{ assetUrl('main.css', 'css') }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ assetUrl('main.css', 'css') }}"></noscript>

{% set vendorCss = assetUrl('vendors.css', 'js', true) %}
{% if vendorCss %}
<link rel="stylesheet" href="{{ vendorCss }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ vendorCss }}"></noscript>
{% endif %}

{% set uiVendorCss = assetUrl('ui-vendors.css', 'js', true) %}
{% if uiVendorCss %}
<link rel="stylesheet" href="{{ uiVendorCss }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ uiVendorCss }}"></noscript>
{% endif %}
