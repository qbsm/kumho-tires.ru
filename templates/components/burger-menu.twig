<section class="burger-menu" id="burgerMenu" role="navigation" aria-label="{{ global.burger.aria_open[lang_code]|default('Menu') }}" aria-hidden="true">
  <div class="container">
    {% for item in items %}
      {% if item.visible is not defined or item.visible %}
      {% set nav_path = item.href | trim('/') %}
      
      {% if lang_code != config.settings.default_lang %}
        {% set nav_path = lang_code ~ '/' ~ nav_path %}
      {% endif %}
      
      {% if nav_path is not empty and not nav_path ends with '/' %}
        {% set nav_path = nav_path ~ '/' %}
      {% endif %}

      <a href="{{ url(nav_path) }}" class="burger-menu__item link">
        <span class="burger-menu__title uppercase">{{ item.title }}</span>
      </a>
      {% if item.children is defined and item.children is not empty %}
        <div class="burger-menu__sub">
          {% for group in item.children %}
            {% if group.group is defined and group.group %}
              <span class="burger-menu__sub-title uppercase">{{ group.group }}</span>
            {% endif %}
            {% for sub in group.items | default([]) %}
              <a href="{{ url(sub.href) }}" class="burger-menu__sub-item link{{ sub.nested is defined and sub.nested ? ' burger-menu__sub-item--nested' : '' }}">{{ sub.title }}</a>
            {% endfor %}
          {% endfor %}
        </div>
      {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</section> 