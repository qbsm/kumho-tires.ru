{
  "name": "contacts",
  "sections": [
    {
      "name": "header",
      "data": {}
    },
    {
      "name": "frame",
      "visible": true,
      "data": {
        "cover": "data/img/about/warehouse.webp"
      }
    },
    {
      "name": "promo",
      "data": {
        "container": "container-sm",
        "heading": {
          "tag": "h1",
          "class": "h1 heading font-2 weight-700 heading-flex uppercase",
          "title": "Контакты"
        },
        "background": {
          "src": "data/img/ui/bg1.webp"
        }
      }
    },
    {
      "name": "content-container",
      "data": {
        "content": {
          "class": "content-contacts-intro",
          "items": [
            {
              "class": "contacts-cards-wrap",
              "content": "<div class='section__subitem contacts-cards'>{% for card in item.cards %}<div class='contacts-card'><h2 class='contacts-card__title font-2 weight-600'>{{ card.title }}</h2>{% if card.desc is defined %}<span class='contacts-card__desc'>{{ card.desc }}</span>{% endif %}<div class='contacts-card__rows'>{% for row in card.rows %}<div class='contacts-card__row'><span class='contacts-card__icon' style=\"--contacts-icon: url('{{ url(row.icon) }}')\" aria-hidden='true'></span><span class='contacts-card__body'><span class='contacts-card__label'>{{ row.label }}</span>{% if row.href is defined %}<a href='{{ row.href }}' class='contacts-card__value link inline weight-400'{% if row.external is defined %} target='_blank' rel='noopener'{% endif %}>{{ row.value }}</a>{% else %}<span class='contacts-card__value'>{{ row.value }}</span>{% endif %}{% if row.note is defined %}<span class='contacts-card__note'>{{ row.note }}</span>{% endif %}</span></div>{% endfor %}</div>{% if card.links is defined %}<div class='contacts-card__links'>{% for link in card.links %}<a href='{{ url(link.href) }}' class='contacts-card__link link inline weight-400'>{{ link.title }}</a>{% endfor %}</div>{% endif %}</div>{% endfor %}</div>",
              "cards": [
                {
                  "title": "Для бизнеса",
                  "rows": [
                    {
                      "icon": "data/img/ui/icons/icon-locate-color-2.svg",
                      "label": "Адрес",
                      "value": "143900, Московская область, город Балашиха, шоссе Энтузиастов, дом 84, помещение 5",
                      "href": "https://yandex.ru/maps/?text=143900%2C%20Московская%20область%2C%20Балашиха%2C%20шоссе%20Энтузиастов%2C%2084",
                      "external": true
                    },
                    {
                      "icon": "data/img/ui/icons/icon-phone-color-2.svg",
                      "label": "Телефон",
                      "value": "8 800 100 77 00",
                      "href": "tel:88001007700"
                    },
                    {
                      "icon": "data/img/ui/icons/icon-mail-color-2.svg",
                      "label": "E-mail",
                      "value": "B2B@svrauto.ru",
                      "href": "mailto:B2B@svrauto.ru"
                    }
                  ]
                },
                {
                  "title": "Покупателям",
                  "rows": [
                    {
                      "icon": "data/img/ui/icons/icon-mail-color-2.svg",
                      "label": "E-mail",
                      "value": "info@kumho-tires.ru",
                      "href": "mailto:info@kumho-tires.ru"
                    }
                  ],
                  "links": [
                    {
                      "title": "Где купить",
                      "href": "/buy"
                    },
                    {
                      "title": "Расширенная гарантия",
                      "href": "/warranty"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "container": "container-sm"
      }
    },
    {
      "name": "content-container",
      "data": {
        "content": {
          "class": "content-contacts",
          "items": [
            {
              "class": "content-wrap form-callback-wrap",
              "content": "<div class='section__subitem heading-wrap container-sm'>{% include 'components/heading.twig' with {'item': item.heading} %}</div><div class='section__subitem container-sm'>{% include 'components/form-callback.twig' with {'data': {'button': {'title': 'Получить консультацию'}}} %}</div>",
              "heading": {
                "tag": "h2",
                "class": "h5 heading font-2 weight-700 heading-flex uppercase",
                "title": "Получить консультацию"
              },
              "catalogs": []
            }
          ]
        }
      }
    },
    {
      "name": "footer",
      "visible": true,
      "data": {
        "form": {
          "heading": "Получить консультацию"
        }
      }
    }
  ]
}
