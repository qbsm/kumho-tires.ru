{% extends 'base.twig' %}

{% block content %}
<div id="page-content">
  {% include 'sections/header.twig' with {'data': {}} %}
  {% if frame_data is defined and frame_data %}
    {% include 'sections/frame.twig' with {'data': frame_data} %}
  {% endif %}
  <main class="tire-detail" role="main">
    {% set t = tire.item %}

    <section class="content-container section">
      <div class="container">
        <div class="tire-detail__grid">

          {# --- Колонка 1: галерея --- #}
          <div class="tire-detail__gallery">
            {% set imageKeys = ['30deg', 'front', 'side', 'back'] %}
            {% set galleryImages = [] %}
            {% for key in imageKeys %}
              {% if tire.images[key] is defined %}
                {% set galleryImages = galleryImages|merge([tire.images[key]]) %}
              {% endif %}
            {% endfor %}

            {% if galleryImages|length > 0 %}
              <div class="tire-detail__main-image">
                {% include 'components/picture.twig' with {
                  'image': galleryImages[0],
                  'alt': galleryImages[0].alt|default(t.name),
                  'sizes_preset': 'content',
                  'loading': 'eager',
                  'class': 'img-responsive tire-detail__img'
                } %}
              </div>
              {% if galleryImages|length > 1 %}
              <div class="tire-detail__thumbs">
                {% for img in galleryImages %}
                <div class="tire-detail__thumb{% if loop.first %} active{% endif %}" data-index="{{ loop.index0 }}">
                  {% include 'components/picture.twig' with {
                    'image': img,
                    'alt': img.alt|default(t.name),
                    'sizes_preset': 'content',
                    'class': 'img-responsive'
                  } %}
                </div>
                {% endfor %}
              </div>
              {% endif %}
            {% endif %}
          </div>

          {# --- Колонка 2: информация --- #}
          <div class="tire-detail__info">
            <div class="section__item block-wrap">
              <div class="tire-detail__header">
                <div class="tire-detail__title-group">
                  <div class="section__subitem heading-wrap">
                    <span class="heading-accent self-start" aria-hidden="true"></span>
                    <h1 class="h1 heading font-2 weight-700 heading-flex uppercase">{{ t.name|default(t.code) }}</h1>
                  </div>
                  {% if tire.season is defined and tire.season %}
                    <span class="tire-detail__badge">{{ tire.season }}</span>
                  {% endif %}
                </div>
                {% if tire.desc.short is defined and tire.desc.short %}
                  <p class="tire-detail__desc">{{ tire.desc.short }}</p>
                {% endif %}
              </div>

            </div>

            {# --- Описание --- #}
            {% if tire.desc.full is defined and tire.desc.full %}
            <div class="section__item block-wrap">
              <div class="section__subitem heading-wrap">
                <span class="heading-accent self-start" aria-hidden="true"></span>
                <h2 class="h2 heading font-2 weight-700 heading-flex uppercase">Описание</h2>
              </div>
              <div class="section__subitem">
                <div class="tire-detail__text longread">{{ tire.desc.full|raw }}</div>
              </div>
              <div class="section__subitem tire-detail__actions">
                <a href="{{ url('/buy') }}" class="button button-sm button-3 button-animated animation-shift uppercase link">Где купить</a>
              </div>
            </div>
            {% endif %}

            {# --- Преимущества --- #}
            {% if tire.features is defined and tire.features %}
            <div class="section__item block-wrap">
              <div class="section__subitem">
                {% set featureItems = [] %}
                {% for feature in tire.features %}
                  {% if feature.title is defined and feature.title %}
                    {% set featureItems = featureItems|merge(['<strong>' ~ feature.title ~ '</strong> — ' ~ feature.text]) %}
                  {% else %}
                    {% set featureItems = featureItems|merge([feature.text]) %}
                  {% endif %}
                {% endfor %}
                {% include 'components/custom-list.twig' with { 'items': featureItems } %}
              </div>
            </div>
            {% endif %}

            {# Тесты производителя — проверяемый факт, в отличие от его же маркетинговых формулировок:
               те оказались общими фразами (местами с опечатками источника) и на страницу не идут. #}
            {% if tire.official is defined and tire.official.tests is defined and tire.official.tests|length > 0 %}
            <div class="section__item block-wrap">
              <div class="section__subitem">
                <p class="tire-detail__note">
                  Независимые тесты, указанные производителем: {{ tire.official.tests|join('; ') }}.
                </p>
              </div>
            </div>
            {% endif %}
          </div>


        {# --- Таблица размеров (на всю ширину грида) --- #}
        {% if tire.sizes is defined and tire.sizes|length > 0 %}
        <div class="section__item block-wrap" style="grid-column: 1 / -1">
          <div class="section__subitem heading-wrap">
            <span class="heading-accent self-start" aria-hidden="true"></span>
            <h2 class="h2 heading font-2 weight-700 heading-flex uppercase">Доступные размеры</h2>
          </div>
          <div class="section__subitem">
            <div class="tire-detail__table-wrap">
              {% set _hasEuLabel = false %}
              {% for size in tire.sizes %}
                {% if size.eu is defined %}{% set _hasEuLabel = true %}{% endif %}
              {% endfor %}
              <table class="tire-detail__table">
                <thead>
                  <tr>
                    <th>Размер</th>
                    <th>Диаметр</th>
                    <th>Индекс нагрузки/скорости</th>
                    <th>C</th>
                    {% if _hasEuLabel %}
                      <th title="Класс топливной экономичности, от A до E">Экономичность<sup>*</sup></th>
                      <th title="Класс сцепления на мокрой дороге, от A до E">Сцепление<sup>*</sup></th>
                      <th title="Уровень внешнего шума качения">Шум, дБ<sup>*</sup></th>
                    {% endif %}
                  </tr>
                </thead>
                <tbody>
                  {% for size in tire.sizes %}
                  <tr>
                    <td>{{ size.label }}</td>
                    <td>R{{ size.diameter }}</td>
                    <td>{{ size.index|default('') }}</td>
                    <td>{{ size.commercial|default(false) ? 'C' : '' }}</td>
                    {% if _hasEuLabel %}
                      <td>{{ size.eu.energy|default('—') }}</td>
                      <td>{{ size.eu.wet|default('—') }}</td>
                      <td>{{ size.eu.noise is defined ? size.eu.noise : '—' }}</td>
                    {% endif %}
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            {% if _hasEuLabel %}
              <p class="tire-detail__note">
                <sup>*</sup> Классы экономичности и сцепления, уровень шума — по регистрациям шины
                в реестре ЕС EPREL. Прочерк означает, что типоразмер в реестре не зарегистрирован.
              </p>
            {% endif %}
          </div>
        </div>
        {% endif %}

        </div>{# /tire-detail__grid #}
      </div>
    </section>

    {% set _faqItems = [] %}
    {% for _pair in pageSeoData.faq_items | default([]) %}
      {% set _faqItems = _faqItems | merge([{
        'icon': {'src': url('/data/img/ui/icons/icon-arrow-down-color-2.svg')},
        'title': _pair.q,
        'answerText': _pair.a,
        'desc': _pair.a
      }]) %}
    {% endfor %}
    {% if _faqItems | length > 0 %}
      {% include 'sections/faq.twig' with {'data': {
        'heading': {'tag': 'h2', 'class': 'h2 heading font-2 weight-700 heading-flex uppercase', 'title': 'Вопросы и ответы'},
        'items': _faqItems
      }} %}
    {% endif %}

    {# Похожие модели: ранжирование по близости, до 4 карточек — перелинковка каталога.
       Только пересечение сезона давало один и тот же блок для 12 моделей из 36 (порядок items
       алфавитный, брались первые четыре) и путало классы техники: коммерческой шине предлагались
       легковые. Считаем близость по серии, классу техники, сезону, приоритету и диаметрам. #}
    {% set _tiresList = load_json('data/json/' ~ lang_code ~ '/pages/tires.json') %}
    {% set _curFilter = tire.filter | default({}) %}
    {% set _curSeasons = _curFilter.season | default([]) %}
    {% set _curVehicle = _curFilter.vehicle | default([]) %}
    {% set _curPriority = _curFilter.priority | default([]) %}
    {% set _curDiameters = _curFilter.diameters | default([]) %}
    {% set _curSeries = tire.item.series | default('') %}

    {% set _scored = [] %}
    {% if _tiresList and _tiresList.items is defined %}
      {% for _slug in _tiresList.items %}
        {% if _slug != tire.slug %}
          {% set _cand = load_json('data/json/' ~ lang_code ~ '/tires/' ~ _slug ~ '.json') %}
          {% if _cand and _cand.visible | default(false) %}
            {% set _f = _cand.filter | default({}) %}
            {% set _score = 0 %}

            {% set _vehicleHit = false %}
            {% for _v in _f.vehicle | default([]) %}
              {% if _v in _curVehicle %}{% set _vehicleHit = true %}{% endif %}
            {% endfor %}
            {% if _vehicleHit %}{% set _score = _score + 4 %}{% endif %}

            {# Сезон — жёсткое условие: летняя шина в блоке зимней это ошибка, а не «похожесть» #}
            {% set _seasonHit = false %}
            {% for _s in _f.season | default([]) %}
              {% if _s in _curSeasons %}{% set _seasonHit = true %}{% endif %}
            {% endfor %}
            {# Шипованная и нешипованная зима — разные покупки, точное совпадение набора ценнее #}
            {% if _seasonHit and _f.season | default([]) | length == _curSeasons | length %}
              {% set _score = _score + 1 %}
            {% endif %}

            {% if _cand.item.series | default('') == _curSeries and _curSeries %}
              {% set _score = _score + 3 %}
            {% endif %}

            {% for _p in _f.priority | default([]) %}
              {% if _p in _curPriority %}{% set _score = _score + 1 %}{% endif %}
            {% endfor %}

            {% set _diaHit = false %}
            {% for _d in _f.diameters | default([]) %}
              {% if _d in _curDiameters %}{% set _diaHit = true %}{% endif %}
            {% endfor %}
            {% if _diaHit %}{% set _score = _score + 1 %}{% endif %}

            {% if _seasonHit %}
              {% set _scored = _scored | merge([{'score': _score + 1, 'item': _cand}]) %}
            {% endif %}
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {# Отбор по убыванию близости: Twig без расширения не сортирует по вычисленному ключу #}
    {% set _related = [] %}
    {% for _level in range(12, 0, -1) %}
      {% for _entry in _scored %}
        {% if _related | length < 4 and _entry.score == _level %}
          {% set _related = _related | merge([_entry.item]) %}
        {% endif %}
      {% endfor %}
    {% endfor %}
    {% if _related|length > 0 %}
    <section class="tires section">
      <div class="container">
        <div class="section__item block-wrap">
          <div class="section__subitem heading-wrap">
            <span class="heading-accent self-start" aria-hidden="true"></span>
            <h2 class="h3 heading font-2 weight-700 heading-flex uppercase">Похожие модели</h2>
          </div>
          <div class="section__subitem cards-tire-wrap">
            {% for tireItem in _related %}
              <div class="section__inner card-tire-wrap">
                {% include 'components/card-tire.twig' with {'item': tireItem, 'heading_tag': 'span'} %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>
    {% endif %}

  </main>
  {% include 'sections/footer.twig' with {'data': global.footer|default({})} %}
</div>
{% endblock %}
