<section class="tire-selector section">
  <div class="container">
    <div class="section__item block-wrap">
      {% if data.heading is defined %}
        <div class="section__subitem heading-wrap">
          <span class="heading-accent self-start" aria-hidden="true"></span>
          {% include 'components/heading.twig' with {'item': data.heading} %}
        </div>
      {% endif %}

      {% set tiresList = load_json('data/json/' ~ lang_code ~ '/pages/tires.json') %}
      {% set tiresItems = [] %}
      {% if tiresList and tiresList.items is not empty %}
        {% for slug in tiresList.items %}
          {% set tireItem = load_json('data/json/' ~ lang_code ~ '/tires/' ~ slug ~ '.json') %}
          {% if tireItem and tireItem.visible | default(false) %}
            {% set tiresItems = tiresItems | merge([tireItem]) %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {% set selectorId = 'tireSelector' ~ random(1000000) %}
      {% set steps = data.steps | default([]) %}
      {% set resultLimit = data.result.limit | default(6) %}
      {% set catalogHref = data.result.catalog_href | default('/tires') %}

      <div
        class="section__subitem tire-selector__app js-tire-selector"
        data-limit="{{ resultLimit }}"
        data-catalog-href="{{ url(catalogHref) }}"
      >
        {% for step in steps %}
          {% set isMultiple = step.multiple | default(false) %}
          <div
            class="tire-selector__step js-selector-step{{ loop.index > 1 ? ' hidden' : '' }}"
            data-key="{{ step.key }}"
            data-type="{{ step.type | default('options') }}"
            {% if isMultiple %}data-multiple="1"{% endif %}
          >
            <div class="tire-selector__step-head">
              <span class="tire-selector__counter uppercase">Шаг {{ loop.index }} из {{ steps | length }}</span>
              <span class="tire-selector__question font-2 weight-600">{{ step.question }}</span>
              {% if step.note is defined and step.note %}
                <span class="tire-selector__note">{{ step.note }}</span>
              {% endif %}
            </div>

            {% if step.type | default('options') == 'options' %}
              <div class="tire-selector__options" {% if isMultiple %}role="group"{% endif %}>
                {% for option in step.options | default([]) %}
                  <button
                    type="button"
                    class="tire-selector__option js-selector-option"
                    data-value="{{ option.value }}"
                    data-label="{{ option.label }}"
                    aria-pressed="false"
                  >
                    <span class="tire-selector__option-mark" aria-hidden="true"></span>
                    <span class="tire-selector__option-title card__title font-2 weight-600">{{ option.label }}</span>
                    {% if option.note is defined and option.note %}
                      <span class="tire-selector__option-desc card__desc">{{ option.note }}</span>
                    {% endif %}
                    {% if option.icon is defined and option.icon %}
                      <span class="tire-selector__option-icon-wrap">
                        <span class="tire-selector__option-icon" style="--selector-icon: url('{{ url(option.icon) }}')" aria-hidden="true"></span>
                      </span>
                    {% endif %}
                  </button>
                {% endfor %}
              </div>
              {% if isMultiple %}
                <div class="tire-selector__step-actions">
                  <button type="button" class="button button-sm button-3 button-animated animation-shift uppercase tire-selector__button disabled js-selector-next">
                    {{ step.submit | default('Далее') }}
                  </button>
                  {% if loop.index > 1 %}
                    <button type="button" class="button button-sm outline-color-2 uppercase tire-selector__button js-selector-back">Назад</button>
                  {% endif %}
                </div>
              {% endif %}

            {% elseif step.type == 'size' %}
              {% set sizeControls = [
                {'key': 'width', 'label': 'Ширина', 'any': 'Любая', 'icon': 'data/img/ui/icons/icon-size-width.svg'},
                {'key': 'profile', 'label': 'Высота профиля', 'any': 'Любая', 'icon': 'data/img/ui/icons/icon-size-profile.svg'},
                {'key': 'diameter', 'label': 'Диаметр', 'any': 'Любой', 'icon': 'data/img/ui/icons/icon-size-diameter.svg'}
              ] %}
              <div class="tire-selector__sizes">
                {% for control in sizeControls %}
                  <div class="tire-selector__size-field">
                    <span class="tire-selector__size-icon" style="--selector-icon: url('{{ url(control.icon) }}')" aria-hidden="true"></span>
                    <label class="tire-selector__size-label" for="{{ selectorId }}-{{ control.key }}">{{ control.label }}</label>
                    <select
                      id="{{ selectorId }}-{{ control.key }}"
                      class="tire-selector__size-select js-selector-size"
                      data-size-key="{{ control.key }}"
                    >
                      <option value="">{{ control.any }}</option>
                    </select>
                  </div>
                {% endfor %}
              </div>
              <div class="tire-selector__step-actions">
                <button type="button" class="button button-sm button-3 button-animated animation-shift uppercase tire-selector__button js-selector-submit">
                  {{ step.submit | default('Показать модели') }}
                </button>
                <button type="button" class="button button-sm outline-color-2 uppercase tire-selector__button js-selector-back">Назад</button>
              </div>
            {% endif %}
          </div>
        {% endfor %}

        <div class="tire-selector__step tire-selector__result hidden js-selector-result">
          <div class="tire-selector__step-head">
            <span class="tire-selector__counter uppercase">Подбор готов</span>
            <span class="tire-selector__question font-2 weight-600">{{ data.result.heading | default('Подходящие модели') }}</span>
            <span class="tire-selector__note js-selector-summary"></span>
          </div>

          <div class="tire-selector__cards js-selector-cards">
            {% for tireItem in tiresItems %}
              {% set filterData = tireItem.filter | default({}) %}
              {% set seasonTokens = '|' %}
              {% for value in filterData.season | default([]) %}
                {% set seasonTokens = seasonTokens ~ value ~ '|' %}
              {% endfor %}
              {% set vehicleTokens = '|' %}
              {% for value in filterData.vehicle | default([]) %}
                {% set vehicleTokens = vehicleTokens ~ value ~ '|' %}
              {% endfor %}
              {% set priorityTokens = '|' %}
              {% for value in filterData.priority | default([]) %}
                {% set priorityTokens = priorityTokens ~ value ~ '|' %}
              {% endfor %}
              {% set sizeTokens = '|' %}
              {% for size in tireItem.sizes | default([]) %}
                {% set sizeTokens = sizeTokens ~ size.label ~ '|' %}
              {% endfor %}
              <div
                class="tire-selector__card-wrap hidden js-selector-card"
                data-season="{{ seasonTokens }}"
                data-vehicle="{{ vehicleTokens }}"
                data-priority="{{ priorityTokens }}"
                data-sizes="{{ sizeTokens }}"
              >
                {% include 'components/card-tire.twig' with {'item': tireItem, 'heading_tag': 'span'} %}
              </div>
            {% endfor %}
          </div>

          <div class="tire-selector__empty hidden js-selector-empty">
            <span class="tire-selector__note">Под такие параметры моделей не нашлось. Измените ответы или посмотрите весь каталог.</span>
          </div>

          <div class="tire-selector__step-actions">
            <a href="{{ url(catalogHref) }}" class="button button-sm button-3 button-animated animation-shift uppercase link tire-selector__button js-selector-catalog">
              {{ data.result.catalog_title | default('Перейти в каталог') }}
            </a>
            <button type="button" class="button button-sm outline-color-2 button-animated animation-shift uppercase tire-selector__button js-selector-restart">
              {{ data.result.restart_title | default('Подобрать заново') }}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
