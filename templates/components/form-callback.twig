{% set formId = 'formCallback' ~ random(1000000) %}
{% set formConfig = global['form-callback'] %}
{% set fields = data.fields | default(formConfig.fields | default([])) %}

<form class="form-callback js-form-callback" novalidate method="post" action="" id="{{ formId }}">
  <div class="form-callback__container">

    {% for field in fields %}
      {% set fieldId = formId ~ '_' ~ field.name %}
      {% set fieldLabel = formConfig.label[lang_code][field.name] | default('') %}
      {% set fieldPlaceholder = formConfig.placeholder[lang_code][field.name] | default('') %}
      {% set isRequired = field.validation.required | default(false) %}

      {# --- Hidden --- #}
      {% if field.type == 'hidden' %}
        <input type="hidden" name="{{ field.name }}" value="{{ field.value | default('') }}">

      {# --- Checkbox --- #}
      {% elseif field.type == 'checkbox' %}
        <div class="form-callback__item form-callback-item-{{ field.name }}">
          <label class="form-callback__custom-checkbox">
            <input id="{{ fieldId }}" type="checkbox" name="{{ field.name }}" class="form-callback__checkbox"{% if isRequired %} aria-required="true"{% endif %}>
            <span class="form-callback__checkmark" aria-hidden="true"></span>
            <span class="form-callback__placeholder uppercase">{{ fieldLabel }}</span>
          </label>
        </div>

      {# --- Select --- #}
      {% elseif field.type == 'select' %}
        <div class="form-callback__item form-callback-item-{{ field.name }}">
          <label class="form-callback__label" for="{{ fieldId }}">
            <span class="form-callback__label-text">{{ fieldLabel }}</span>
            {% if isRequired %}<span class="form-callback__required" aria-hidden="true"> *</span>{% endif %}
          </label>
          <select id="{{ fieldId }}" name="{{ field.name }}" class="form-callback__input form-callback__select"{% if isRequired %} aria-required="true"{% endif %}>
            {% for option in field.options | default([]) %}
              <option value="{{ option.value }}">{{ option.label[lang_code] | default(option.label.ru | default('')) }}</option>
            {% endfor %}
          </select>
        </div>

      {# --- Textarea --- #}
      {% elseif field.type == 'textarea' %}
        <div class="form-callback__item form-callback-item-{{ field.name }}">
          <label class="form-callback__label" for="{{ fieldId }}">
            <span class="form-callback__label-text">{{ fieldLabel }}</span>
            {% if isRequired %}<span class="form-callback__required" aria-hidden="true"> *</span>{% endif %}
          </label>
          <textarea id="{{ fieldId }}" name="{{ field.name }}" class="form-callback__input" placeholder="{{ fieldPlaceholder }}"{% if isRequired %} aria-required="true"{% endif %}{% if field.validation.maxLength is defined %} maxlength="{{ field.validation.maxLength }}"{% endif %}></textarea>
        </div>

      {# --- File --- #}
      {% elseif field.type == 'file' %}
        <div class="form-callback__item form-callback-item-{{ field.name }}">
          <label class="form-callback__label" for="{{ fieldId }}">
            <span class="form-callback__label-text">{{ fieldLabel }}</span>
            {% if isRequired %}<span class="form-callback__required" aria-hidden="true"> *</span>{% endif %}
          </label>
          <input id="{{ fieldId }}" type="file" name="{{ field.name }}" class="form-callback__input form-callback__file"{% if field.accept is defined %} accept="{{ field.accept }}"{% endif %}{% if field.multiple | default(false) %} multiple{% endif %}{% if isRequired %} aria-required="true"{% endif %}>
        </div>

      {# --- Radio --- #}
      {% elseif field.type == 'radio' %}
        <fieldset class="form-callback__item form-callback-item-{{ field.name }}"{% if isRequired %} aria-required="true"{% endif %}>
          <legend class="form-callback__label">
            <span class="form-callback__label-text">{{ fieldLabel }}</span>
            {% if isRequired %}<span class="form-callback__required" aria-hidden="true"> *</span>{% endif %}
          </legend>
          <div class="form-callback__radio-group">
            {% for option in field.options | default([]) %}
              {% set optionId = fieldId ~ '_' ~ loop.index0 %}
              <label class="form-callback__radio-option" for="{{ optionId }}">
                <input id="{{ optionId }}" type="radio" name="{{ field.name }}" value="{{ option.value }}" class="form-callback__radio-input">
                <span class="form-callback__radio-mark" aria-hidden="true"></span>
                <span class="form-callback__radio-label">{{ option.label[lang_code] | default(option.label.ru | default('')) }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>

      {# --- Default: input (text, email, tel, number) --- #}
      {% else %}
        <div class="form-callback__item form-callback-item-{{ field.name }}">
          <label class="form-callback__label" for="{{ fieldId }}">
            <span class="form-callback__label-text">{{ fieldLabel }}</span>
            {% if isRequired %}<span class="form-callback__required" aria-hidden="true"> *</span>{% endif %}
          </label>
          <input id="{{ fieldId }}" type="{{ field.type | default('text') }}" class="form-callback__input" name="{{ field.name }}" placeholder="{{ fieldPlaceholder }}"{% if field.inputmode is defined %} inputmode="{{ field.inputmode }}"{% endif %}{% if field.autocomplete is defined %} autocomplete="{{ field.autocomplete }}"{% endif %}{% if isRequired %} aria-required="true"{% endif %}{% if field.validation.maxLength is defined %} maxlength="{{ field.validation.maxLength }}"{% endif %}>
        </div>
      {% endif %}

    {% endfor %}

    <div class="form-callback__item button-wrap">
      <button class="button button-sm outline-color-2 button-animated animation-shift uppercase link" type="submit">
        {% if data.button is defined and data.button.title is defined %}
          {{ data.button.title }}
        {% else %}
          {{ formConfig.button[lang_code].title }}
        {% endif %}
      </button>
    </div>
    <div class="form-callback__item form-callback-item-rules rules-wrap">
      <span class="form-callback__rules">{{ formConfig.rules[lang_code].policy | raw }}</span>
    </div>
    <div class="form-callback__item form-callback__error hidden" aria-live="polite" aria-atomic="true">
      <span id="{{ formId }}Error" class="form-callback__error-text" role="alert" aria-live="assertive">{{ formConfig.error[lang_code].title }}</span>
    </div>
  </div>
</form>
