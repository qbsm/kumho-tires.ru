{
  "name": "contacts",
  "sections": [
    {
      "name": "header",
      "data": {}
    },
    {
      "name": "frame",
      "visible": true,
      "data": {
        "cover": "data/img/about/warehouse.webp"
      }
    },
    {
      "name": "promo",
      "data": {
        "container": "container",
        "heading": {
          "tag": "h1",
          "class": "h1 heading font-2 weight-700 heading-flex uppercase",
          "title": "Контакты"
        },
        "background": {
          "src": "data/img/ui/bg1.webp"
        }
      }
    },
    {
      "name": "content-container",
      "data": {
        "content": {
          "class": "content-contacts",
          "items": [
            {
              "class": "content-wrap",
              "content": "<div class='section__subitem contacts-grid'><div class='contacts-main'><div class='contacts-main__head'>{% include 'components/heading.twig' with {'item': item.business.heading} %}<span class='contacts-note'>{{ item.business.desc }}</span></div><div class='contacts-list'>{% for row in item.rows %}<a class='contacts-item link' href='{{ row.href }}'{% if row.external is defined %} target='_blank' rel='noopener'{% endif %}><span class='contacts-item__icon'><img src='{{ url(row.icon) }}' alt='' loading='lazy'></span><span class='contacts-item__body'><span class='contacts-item__label'>{{ row.label }}</span><span class='contacts-item__value'>{{ row.value | raw }}</span></span></a>{% endfor %}</div><div class='contacts-buyers'><span class='contacts-buyers__label'>{{ item.buyers.title }}</span><span class='contacts-note'>{{ item.buyers.desc }}</span><div class='contacts-buyers__actions'>{% for link in item.buyers.items %}<a href='{{ url(link.href) }}' class='button button-sm {{ loop.first ? 'button-3' : 'outline-color-2' }} button-animated animation-shift uppercase link'>{{ link.title }}</a>{% endfor %}</div></div></div><aside class='contacts-aside'>{% include 'components/heading.twig' with {'item': item.form.heading} %}<span class='contacts-note'>{{ item.form.desc }}</span><div class='contacts-aside__form'>{% include 'components/form-callback.twig' with {'data': {'button': {'title': item.form.button}}} %}</div></aside></div><div class='section__subitem contacts-map'><iframe src='{{ item.map.src }}' title='{{ item.map.alt }}' loading='lazy' allowfullscreen></iframe></div><div class='section__subitem contacts-legal'><span class='contacts-legal__text'>{{ global.owner[lang_code] }}</span></div>",
              "business": {
                "heading": {
                  "tag": "h2",
                  "class": "h3 heading font-2 weight-700 heading-flex uppercase",
                  "title": "Контакты для бизнеса"
                },
                "desc": "Для партнёров и оптовых покупателей: условия поставок, подключение к дилерской сети и работа с ассортиментом Kumho."
              },
              "rows": [
                {
                  "icon": "data/img/ui/icons/icon-locate-color-2.svg",
                  "label": "Адрес",
                  "value": "143900, Московская область, город Балашиха,<br>шоссе Энтузиастов, дом 84, помещение 5",
                  "href": "https://yandex.ru/maps/?text=Московская%20область%2C%20Балашиха%2C%20шоссе%20Энтузиастов%2C%2084",
                  "external": true
                },
                {
                  "icon": "data/img/ui/icons/icon-phone-color-2.svg",
                  "label": "Телефон",
                  "value": "8 800 100 77 00",
                  "href": "tel:88001007700"
                },
                {
                  "icon": "data/img/ui/icons/icon-mail-color-2.svg",
                  "label": "E-mail",
                  "value": "B2B@svrauto.ru",
                  "href": "mailto:B2B@svrauto.ru"
                }
              ],
              "buyers": {
                "title": "Покупателям",
                "desc": "Розничные покупки — в авторизованных шинных центрах: 155 точек продаж в 55 городах России. Там же оформляется расширенная гарантия.",
                "items": [
                  {
                    "title": "Где купить",
                    "href": "/buy"
                  },
                  {
                    "title": "Расширенная гарантия",
                    "href": "/warranty"
                  }
                ]
              },
              "form": {
                "heading": {
                  "tag": "h2",
                  "class": "h3 heading font-2 weight-700 heading-flex uppercase",
                  "title": "Получить консультацию"
                },
                "desc": "Оставьте телефон — перезвоним и ответим по поставкам и сотрудничеству.",
                "button": "Отправить"
              },
              "map": {
                "src": "https://yandex.ru/map-widget/v1/?text=Московская%20область%2C%20Балашиха%2C%20шоссе%20Энтузиастов%2C%2084&z=16",
                "alt": "143900, Московская область, город Балашиха, шоссе Энтузиастов, дом 84, помещение 5"
              }
            }
          ]
        },
        "container": "container"
      }
    },
    {
      "name": "footer",
      "visible": true,
      "data": {
        "form": {
          "heading": "Получить консультацию"
        }
      }
