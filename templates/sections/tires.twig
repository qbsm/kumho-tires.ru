{% set preset = filter_preset | default({}) %}
{% set presetSeason = preset.season | default('') %}
{% set presetWidth = preset.width | default('') %}
{% set presetProfile = preset.profile | default('') %}
{% set presetDiameter = preset.diameter | default('') %}
{% set presetFamily = preset.family | default('') %}
{% set presetSize = presetWidth or presetProfile or presetDiameter %}
{# Размер держится при смене сезона: со страницы размера сезонный чип ведёт на
   /tires/<сезон>/<размер>, а повторный клик снимает сезон и возвращает к размеру,
   а не в общий каталог #}
{% set sizeSegment = presetSize ? presetWidth ~ '-' ~ presetProfile ~ '-r' ~ presetDiameter : '' %}
{% set catalogRoot = '/tires' ~ (presetSeason ? '/' ~ presetSeason : '') %}
{# Ссылки типоразмеров держат контекст раздела: со страницы нешипованных ведут
   на /tires/friction/<размер>, со страницы линейки — на /tires/<линейка>/<размер>.
   Раньше вели в общий каталог и сбрасывали фильтр. #}
{% set sizesBase = '/tires' ~ (presetSeason ? '/' ~ presetSeason : (presetFamily ? '/' ~ presetFamily : '')) %}
{% set catalogPath = '/tires' ~ (sizeSegment ? '/' ~ sizeSegment : '') %}
<section class="tires section"{% if page_id is defined and page_id == 'tires-list' %} data-catalog-path="{{ catalogPath }}" data-catalog-root="{{ sizesBase }}"{% endif %}>
  <div class="container">
    <div class="section__item block-wrap">
      {% if data.heading is defined %}
        <div class="section__subitem heading-wrap">
          <span class="heading-accent self-start" aria-hidden="true"></span>
          {% include 'components/heading.twig' with {'item': data.heading} %}
        </div>
      {% endif %}
      {% set tiresList = load_json('data/json/' ~ lang_code ~ '/pages/tires.json') %}
      {% set filterVisible = true %}
      {% if data.filter is defined %}
        {% if data.filter is iterable %}
          {% set filterVisible = data.filter.visible is defined ? data.filter.visible : true %}
        {% else %}
          {% set filterVisible = data.filter ? true : false %}
        {% endif %}
      {% endif %}
      {% set tiresItems = [] %}
      {% set seasonBySlug = {} %}
      {% set familyBySlug = {} %}
      {% set allDiameters = [] %}
      {% set allWidths = [] %}
      {% set allProfiles = [] %}
      {% if tiresList and tiresList.items is not empty %}
        {% for slug in tiresList.items %}
          {% set tireItem = load_json('data/json/' ~ lang_code ~ '/tires/' ~ slug ~ '.json') %}
          {% if tireItem and tireItem.visible | default(false) %}
            {% set tiresItems = tiresItems | merge([tireItem]) %}
            {% set filterData = tireItem.filter | default({}) %}
            {% set seasonRaw = filterData.season | default(['summer']) %}
            {% set seasonList = seasonRaw is iterable ? seasonRaw : [seasonRaw] %}
            {% set seasonCodes = [] %}
            {% for season in seasonList %}
              {% set seasonNorm = season|lower|trim %}
              {% set code = '' %}
              {% if seasonNorm in ['лето', 'summer'] %}
                {% set code = 'summer' %}
              {% elseif seasonNorm in ['зима', 'winter'] %}
                {% set code = 'winter' %}
              {% elseif seasonNorm in ['всесезонные', 'всесезонная', 'allseason', 'all season', 'all-season'] %}
                {% set code = 'allseason' %}
              {% elseif seasonNorm in ['шипованные', 'шипы', 'studded'] %}
                {% set code = 'studded' %}
              {% endif %}
              {% if code and code not in seasonCodes %}
                {% set seasonCodes = seasonCodes | merge([code]) %}
              {% endif %}
            {% endfor %}
            {# «Нешипованные» — не отдельный сезон в данных, а зимние без шипов #}
            {% if 'winter' in seasonCodes and 'studded' not in seasonCodes %}
              {% set seasonCodes = seasonCodes | merge(['friction']) %}
            {% endif %}
            {% set seasonBySlug = seasonBySlug | merge({(tireItem.slug | default(slug)): seasonCodes}) %}
            {% set familyBySlug = familyBySlug | merge({(tireItem.slug | default(slug)): filterData.family | default('')}) %}
            {% set diameters = filterData.diameters | default(filterData.diameter | default([])) %}
            {% set widths = filterData.widths | default(filterData.width | default([])) %}
            {% set profiles = filterData.profiles | default(filterData.profile | default(filterData.heights | default(filterData.height | default([])))) %}
            {% for value in diameters %}
              {% if value not in allDiameters %}
                {% set allDiameters = allDiameters | merge([value]) %}
              {% endif %}
            {% endfor %}
            {% for value in widths %}
              {% if value not in allWidths %}
                {% set allWidths = allWidths | merge([value]) %}
              {% endif %}
            {% endfor %}
            {% for value in profiles %}
              {% if value not in allProfiles %}
                {% set allProfiles = allProfiles | merge([value]) %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      {% endif %}
      {# Сезон и размер из адреса режут каталог на сервере: страница фильтра, отдающая весь
         список, для поиска неотличима от /tires — именно из-за этого выигрывала главная #}
      {% if presetSeason or presetFamily or presetSize %}
        {% set matchedItems = [] %}
        {% for tireItem in tiresItems %}
          {% set itemSeasons = seasonBySlug[tireItem.slug | default('')] | default([]) %}
          {% set seasonOk = presetSeason ? (presetSeason in itemSeasons) : true %}
          {% set familyOk = presetFamily ? (familyBySlug[tireItem.slug | default('')] | default('') == presetFamily) : true %}
          {% set sizeOk = true %}
          {% if presetSize %}
            {% set sizeOk = false %}
            {% for size in tireItem.sizes | default([]) %}
              {% set parts = size.label | default('') | lower | split('r') %}
              {% set wp = parts[0] | default('') | split('/') %}
              {% set sizeWidth = wp[0] | default('') | trim %}
              {% set sizeProfile = wp[1] | default('') | trim %}
              {% set sizeDiameter = parts[1] | default('') | trim | replace({'c': ''}) %}
              {% set hit = true %}
              {% if presetWidth and sizeWidth != presetWidth %}{% set hit = false %}{% endif %}
              {% if presetProfile and sizeProfile != presetProfile %}{% set hit = false %}{% endif %}
              {% if presetDiameter and sizeDiameter != presetDiameter %}{% set hit = false %}{% endif %}
              {% if hit %}{% set sizeOk = true %}{% endif %}
            {% endfor %}
          {% endif %}
          {% if seasonOk and familyOk and sizeOk %}
            {% set matchedItems = matchedItems | merge([tireItem]) %}
          {% endif %}
        {% endfor %}
        {% set tiresItems = matchedItems %}
      {% endif %}
      {# Страница типоразмера: состав каталога в этом размере — из того же
         отфильтрованного списка, чтобы текст не расходился с выдачей #}
      {% if presetSize and tiresItems | length > 0 %}
        {% set sizeTitle = presetWidth ~ '/' ~ presetProfile ~ ' R' ~ presetDiameter %}
        {% set sizeGroupLabels = {'summer': 'летние', 'allseason': 'всесезонные', 'studded': 'шипованные', 'friction': 'нешипованные'} %}
        {% set sizeGroups = [] %}
        {% for code, groupLabel in sizeGroupLabels %}
          {% set groupLinks = [] %}
          {% for tireItem in tiresItems %}
            {% if code in (seasonBySlug[tireItem.slug | default('')] | default([])) %}
              {% set groupLinks = groupLinks | merge([
                '<a href="' ~ url('/tires/' ~ tireItem.slug) ~ '" class="link inline weight-400">'
                ~ (tireItem.item.name | default(tireItem.slug) | replace({'Kumho ': ''})) ~ '</a>'
              ]) %}
            {% endif %}
          {% endfor %}
          {% if groupLinks | length > 0 %}
            {% set sizeGroups = sizeGroups | merge([groupLabel ~ ' — ' ~ groupLinks | join(', ')]) %}
          {% endif %}
        {% endfor %}
        {% set sizeCount = tiresItems | length %}
        {% set sizeCount10 = sizeCount % 10 %}
        {% set sizeCount100 = sizeCount % 100 %}
        {% if sizeCount10 == 1 and sizeCount100 != 11 %}
          {% set sizeCountWord = 'модель' %}
        {% elseif sizeCount10 >= 2 and sizeCount10 <= 4 and (sizeCount100 < 12 or sizeCount100 > 14) %}
          {% set sizeCountWord = 'модели' %}
        {% else %}
          {% set sizeCountWord = 'моделей' %}
        {% endif %}
        <div class="section__subitem longread-wrap">
          <span class="longread">
            <p>В размере <b>{{ sizeTitle }}</b> в каталоге <b>{{ sizeCount }} {{ sizeCountWord }}</b> Kumho: {{ sizeGroups | join('; ') | raw }}.</p>
          </span>
        </div>
      {% endif %}
      {% set previewLimit = data.preview_limit | default(0) %}
      {% set hasPreviewLimit = previewLimit > 0 %}
      {# JSON-LD: каталог моделей (ItemList) — только на полной странице каталога, для поисковиков и LLM #}
      {% if not hasPreviewLimit %}
        {% set _catalogLd = [] %}
        {% for t in tiresItems %}
          {% if t.slug | default('') %}
            {% set _catalogLd = _catalogLd | merge([{
              '@type': 'ListItem',
              'position': _catalogLd|length + 1,
              'item': {
                '@type': 'Product',
                'name': t.item.name | default(t.slug),
                'url': url('/tires/' ~ t.slug),
                'brand': {'@type': 'Brand', 'name': 'Kumho', 'alternateName': ['Кумхо']}
              }
            }]) %}
          {% endif %}
        {% endfor %}
        {% if _catalogLd | length > 0 %}
        <script type="application/ld+json">
        {{ {'@context': 'https://schema.org', '@type': 'ItemList', 'name': 'Каталог шин Kumho', 'numberOfItems': _catalogLd|length, 'itemListElement': _catalogLd}|json_encode|raw }}
        </script>
        {% endif %}
      {% endif %}
      {% set renderedItems = hasPreviewLimit ? (tiresItems | slice(0, previewLimit)) : tiresItems %}
      {% set allModelsLinkVisible = false %}
      {% set allModelsLinkTitle = 'Все модели' %}
      {% set allModelsLinkHref = '/tires/' %}
      {% if data.all_models_link is defined and data.all_models_link %}
        {% set allModelsLinkVisible = data.all_models_link.visible | default(false) %}
        {% set allModelsLinkTitle = data.all_models_link.title | default('Все модели') %}
        {% set allModelsLinkHref = data.all_models_link.href | default('/tires/') %}
      {% endif %}

      {% if filterVisible %}
        {% set diameterOptions = [{'value': '', 'label': 'Все'}] %}
        {% for value in allDiameters|sort %}
          {% set diameterOptions = diameterOptions|merge([{'value': value, 'label': value}]) %}
        {% endfor %}
        {% set profileOptions = [{'value': '', 'label': 'Все'}] %}
        {% for value in allProfiles|sort %}
          {% set profileOptions = profileOptions|merge([{'value': value, 'label': value}]) %}
        {% endfor %}
        {% set widthOptions = [{'value': '', 'label': 'Все'}] %}
        {% for value in allWidths|sort %}
          {% set widthOptions = widthOptions|merge([{'value': value, 'label': value}]) %}
        {% endfor %}
        {# Сезонные разделы — самостоятельные посадочные, поэтому ссылка на них нужна отовсюду,
           где показан фильтр: с главной на /tires/winter иначе не ведёт ни одна ссылка #}
        {% set seasonHrefBase = '/tires' %}
        {% set seasonButtons = [] %}
        {% for s in data.filter.seasons | default([]) %}
          {% set btn = {'label': s.label, 'class': 'js-select-season', 'data_attr_name': 'data-season', 'data_attr': s.value} %}
          {% if seasonHrefBase %}
            {% set btn = btn | merge({'href': seasonHrefBase ~ '/' ~ s.value ~ (sizeSegment ? '/' ~ sizeSegment : '')}) %}
          {% endif %}
          {% if s.disabled is defined and s.disabled %}
            {% set btn = btn | merge({'disabled': true}) %}
          {% endif %}
          {% if s.icon is defined and s.icon %}
            {% set btn = btn | merge({'icon': s.icon}) %}
          {% endif %}
          {% set seasonButtons = seasonButtons | merge([btn]) %}
        {% endfor %}
        {% set tiresFilter = {
          'root_class': 'section__subitem filter-wrap',
          'groups': [
            {
              'type': 'buttons',
              'class': 'seasons-wrap',
              'buttons': seasonButtons
            },
            {
              'type': 'select',
              'class': 'select-wrap',
              'row': 'sizes',
              'id': 'tires-diameter',
              'icon': 'data/img/ui/icons/icon-size-diameter.svg',
              'label': 'Диаметр',
              'select_class': 'custom-select js-select js-select-diameter',
              'options': diameterOptions
            },
            {
              'type': 'select',
              'class': 'select-wrap',
              'row': 'sizes',
              'id': 'tires-profile',
              'icon': 'data/img/ui/icons/icon-size-profile.svg',
              'label': 'Высота профиля',
              'select_class': 'custom-select js-select js-select-profile',
              'options': profileOptions
            },
            {
              'type': 'select',
              'class': 'select-wrap',
              'row': 'sizes',
              'id': 'tires-width',
              'icon': 'data/img/ui/icons/icon-size-width.svg',
              'label': 'Ширина',
              'select_class': 'custom-select js-select js-select-width',
              'options': widthOptions
            }
          ]
        } %}
        <div
          class="js-filter-preset hidden"
          data-season="{{ preset.season | default('') }}"
          data-width="{{ preset.width | default('') }}"
          data-profile="{{ preset.profile | default('') }}"
          data-diameter="{{ preset.diameter | default('') }}"
        ></div>
        {% include 'components/filter.twig' with {'filter': tiresFilter} %}
      {% endif %}

      {% if renderedItems is not empty %}
        <div class="section__subitem cards-tire-wrap">
          {% for tireItem in renderedItems %}
            {% set seasonCodes = seasonBySlug[tireItem.slug | default('')] | default([]) %}
            {% set dataSeasons = '|' %}
            {% for value in seasonCodes %}
              {% set dataSeasons = dataSeasons ~ value ~ '|' %}
            {% endfor %}
            {% set dataSizes = '|' %}
            {% for size in tireItem.sizes | default([]) %}
              {% set dataSizes = dataSizes ~ size.label ~ '|' %}
            {% endfor %}
            <div
              class="section__inner card-tire-wrap js-filter-card"
              data-season="{{ dataSeasons }}"
              data-sizes="{{ dataSizes }}"
            >
              {% include 'components/card-tire.twig' with {'item': tireItem, 'heading_tag': (page_id is defined and page_id == 'tires-list') ? 'h2' : 'span'} %}
            </div>
          {% endfor %}
        </div>
        {% if allModelsLinkVisible %}
          <div class="section__subitem all-models-link-wrap">
            <a href="{{ url(allModelsLinkHref) }}" class="button button-sm outline-color-2 button-animated animation-shift uppercase link">{{ allModelsLinkTitle }}</a>
          </div>
        {% endif %}
        <div class="section__subitem filter-empty-wrap hidden js-filter-empty">
          <span class="filter-empty-text">Такие модели не найдены</span>
        </div>
        {# Популярные типоразмеры — единственный путь к этим страницам, кроме sitemap:
           селекты фильтра меняют адрес скриптом, ссылками их не обойти #}
        {% set indexableSizes = config.settings.collections.tires.filters.indexable_sizes | default([]) %}
        {% if not hasPreviewLimit and not presetSize and indexableSizes | length > 0 %}
          <nav class="section__subitem tires__sizes" aria-label="Популярные типоразмеры">
            <span class="tires__sizes-title uppercase">Популярные типоразмеры</span>
            <div class="tires__sizes-list">
              {% for sizeSlug in indexableSizes %}
                {% set sizeParts = sizeSlug | split('-') %}
                <a href="{{ url(sizesBase ~ '/' ~ sizeSlug) }}" class="link color-2 underline-center tires__sizes-link">{{ sizeParts[0] }}/{{ sizeParts[1] }} {{ sizeParts[2] | upper }}</a>
              {% endfor %}
            </div>
          </nav>
        {% endif %}
      {% endif %}
    </div>
  </div>
</section>
