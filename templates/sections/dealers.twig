{% set urlSyncCity = data.url_sync_city | default(false) %}
{# На /buy/<город> сервер рендерит только точки этого города: полный список из ~155 магазинов
   на каждой городской странице — это 600+ КиБ HTML и дубль-контент между 56 URL #}
{% set pageCitySlug = (urlSyncCity and route_params is defined and route_params|length == 1) ? route_params[0] : '' %}
{% set metaTitleBase = data.meta_title_base | default('') %}
{% set metaTitleCityTemplate = data.meta_title_city_template | default('') %}
{% set metaDescriptionBase = data.meta_description_base | default('') %}
{% set metaDescriptionCityTemplate = data.meta_description_city_template | default('') %}
<section
  class="dealers section"
  id="dealers"
  {% if urlSyncCity %}
    data-url-sync-city="1"
    {% if metaTitleBase %}data-meta-title-base="{{ metaTitleBase | e('html_attr') }}"{% endif %}
    {% if metaTitleCityTemplate %}data-meta-title-city-template="{{ metaTitleCityTemplate | e('html_attr') }}"{% endif %}
    {% if metaDescriptionBase %}data-meta-description-base="{{ metaDescriptionBase | e('html_attr') }}"{% endif %}
    {% if metaDescriptionCityTemplate %}data-meta-description-city-template="{{ metaDescriptionCityTemplate | e('html_attr') }}"{% endif %}
    {% if pageCitySlug %}data-server-filtered="1"{% endif %}
  {% endif %}>
  <div class="container">
    {% set dealersData = load_json('data/json/' ~ lang_code ~ '/pages/dealers.json') %}
    {% set dealerItems = dealersData.items | default(data.items | default([])) %}
    {% set onlyMappedCards = data.map.only_mapped_cards | default(false) %}
    {% if pageCitySlug %}
      {% set renderDealerItems = [] %}
      {% for item in dealerItems %}
        {% if city_to_slug(item.city|default('')) == pageCitySlug %}
          {% set renderDealerItems = renderDealerItems|merge([item]) %}
        {% endif %}
      {% endfor %}
    {% else %}
      {% set renderDealerItems = dealerItems %}
    {% endif %}

    {# JSON-LD: точки продаж (ItemList) — где купить шины Kumho, с адресом/гео/телефоном #}
    {# На странице города (/buy/<город>) ItemList сужается до его точек — local SEO без чужих адресов #}
    {% set _ldCitySlug = (urlSyncCity and route_params is defined and route_params|length == 1) ? route_params[0] : '' %}
    {% set _ldCityName = '' %}
    {% set _stores = [] %}
    {% for item in dealerItems %}
      {% if item.location is defined and item.location and (_ldCitySlug == '' or city_to_slug(item.city|default('')) == _ldCitySlug) %}
        {% if _ldCitySlug and _ldCityName == '' %}{% set _ldCityName = item.city|default('') %}{% endif %}
        {% set _loc = item.location|split(',') %}
        {% set _addr = {'@type': 'PostalAddress', 'streetAddress': item.address|default(''), 'addressCountry': 'RU'} %}
        {% if item.city|default('') is not empty %}{% set _addr = _addr|merge({'addressLocality': item.city}) %}{% endif %}
        {% if item.region|default('') is not empty %}{% set _addr = _addr|merge({'addressRegion': item.region}) %}{% endif %}
        {% set _store = {'@type': 'AutoPartsStore', 'name': item.name|default(''), 'address': _addr} %}
        {% if _loc|length == 2 %}{% set _store = _store|merge({'geo': {'@type': 'GeoCoordinates', 'latitude': _loc[0]|trim, 'longitude': _loc[1]|trim}}) %}{% endif %}
        {% set _phones = [] %}
        {% for ph in item.phones|default([]) %}{% if ph.title is defined %}{% set _phones = _phones|merge([ph.title]) %}{% endif %}{% endfor %}
        {% if _phones|length > 0 %}{% set _store = _store|merge({'telephone': _phones}) %}{% endif %}
        {% if item.site.href|default('') is not empty %}{% set _store = _store|merge({'url': item.site.href}) %}{% endif %}
        {% set _stores = _stores|merge([{'@type': 'ListItem', 'position': _stores|length + 1, 'item': _store}]) %}
      {% endif %}
    {% endfor %}
    {% if _stores|length > 0 %}
    <script type="application/ld+json">
    {{ {'@context': 'https://schema.org', '@type': 'ItemList', 'name': _ldCityName ? 'Где купить шины Kumho: ' ~ _ldCityName : 'Где купить шины Kumho', 'numberOfItems': _stores|length, 'itemListElement': _stores}|json_encode|raw }}
    </script>
    {% endif %}
    {% set filterVisible = true %}
    {% if data.filter is defined %}
      {% if data.filter is iterable %}
        {% set filterVisible = data.filter.visible is defined ? data.filter.visible : true %}
      {% else %}
        {% set filterVisible = data.filter ? true : false %}
      {% endif %}
    {% endif %}
    {% set cityOptions = [] %}
    {% set hasBshm = false %}
    {% for dealer in dealerItems %}
      {% if not onlyMappedCards or (dealer.location is defined and dealer.location) %}
        {% set dealerCity = dealer.city | default('') | trim %}
        {% set bshmData = dealer.bshm | default({}) %}
        {% set bshmVisible = bshmData.visible | default(false) %}
        {% if dealerCity and dealerCity not in cityOptions %}
          {% set cityOptions = cityOptions | merge([dealerCity]) %}
        {% endif %}
        {% if bshmVisible %}
          {% set hasBshm = true %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% set cityCases = load_json('data/json/' ~ lang_code ~ '/city-cases.json') | default({}) %}
    {% set headingBase = data.heading.title | default('') %}
    {% set headingCityTemplate = data.heading_city_template | default(headingBase ~ ' в {city}') %}
    {% set initialHeadingCityCase = '' %}
    {% if urlSyncCity and route_params is defined and route_params|length == 1 %}
      {% for city in cityOptions %}
        {% if city_to_slug(city) == route_params[0] %}
          {% set initialHeadingCityCase = cityCases[city] | default(city) %}
        {% endif %}
      {% endfor %}
    {% endif %}
    {% set headingTitle = initialHeadingCityCase != ''
      ? headingCityTemplate | replace({'{city}': initialHeadingCityCase})
      : headingBase %}
    {% if data.heading is defined %}
      {% set citiesCasesJson = (cityCases | length > 0) ? cityCases | json_encode : '' %}
      <div
        class="section__item heading-wrap js-dealers-heading"
        {% if urlSyncCity %}
          data-heading-base="{{ headingBase | e('html_attr') }}"
          data-heading-city-template="{{ headingCityTemplate | e('html_attr') }}"
          {% if citiesCasesJson %}data-city-cases="{{ citiesCasesJson | e('html_attr') }}"{% endif %}
        {% endif %}>
        <span class="heading-accent self-start" aria-hidden="true"></span>
        {% include 'components/heading.twig' with {'item': data.heading | merge({'title': headingTitle})} %}
      </div>
    {% endif %}

    {% if filterVisible %}
      {% set citySelectOptions = [{'value': '', 'label': 'Все'}] %}
      {% for city in cityOptions | sort %}
        {% set citySelectOptions = citySelectOptions|merge([{'value': city, 'label': city}]) %}
      {% endfor %}
      {% set dealerFilterGroups = [
        {
          'type': 'select',
          'class': 'select-wrap',
          'id': 'dealers-city',
          'label': 'Город',
          'select_class': 'custom-select js-dealers-city',
          'options': citySelectOptions
        },
        {
          'type': 'toggle',
          'class': 'option-wrap',
          'label': 'Расширенная гарантия',
          'icon': '/data/img/ui/icons/icon-doc-color-2.svg',
          'input_class': 'filter__checkbox js-dealers-guarantee'
        }
      ] %}
      {% if hasBshm %}
        {% set dealerFilterGroups = dealerFilterGroups|merge([
          {
            'type': 'toggle',
            'class': 'option-wrap',
            'label': 'Бесплатный шиномонтаж',
            'icon': '/data/img/ui/icons/icon-check-sm-color-2.svg',
            'input_class': 'filter__checkbox js-dealers-bshm'
          }
        ]) %}
      {% endif %}
      {% set dealersFilter = {
        'root_class': 'section__item filter-wrap js-dealers-filter',
        'groups': dealerFilterGroups
      } %}
      {% include 'components/filter.twig' with {'filter': dealersFilter} %}
    {% endif %}

    {% if data.map is defined %}
      <div class="section__item map-wrap">
        {% set mapCenter = data.map.center|default('55.755819, 37.617644') %}
        {% set mapZoom = data.map.zoom|default(5) %}
        <div
          class="map js-map js-dealers-map"
          data-center="{{ mapCenter }}"
          data-zoom="{{ mapZoom }}"
          data-geolocation="{{ data.map.geolocation|default(false) ? '1' : '0' }}"
          data-fallback-src="{{ data.map.src|default('') }}"
          aria-label="Карта точек продаж">
          {% for item in renderDealerItems %}
            {% set dealerId = item.id | default(loop.index) %}
            {% set phones = item.phones | default([]) %}
            {% set guaranteeData = item.guarantee | default({}) %}
            {% set bshmData = item.bshm | default({}) %}
            {% set guaranteeVisible = guaranteeData.visible | default(false) %}
            {% set guaranteeTitle = guaranteeData.title | default('Расширенная гарантия') %}
            {% set bshmVisible = bshmData.visible | default(false) %}
            {% set bshmTitle = bshmData.title | default('Бесплатный шиномонтаж') %}
            {% if item.location is defined and item.location %}
              <div
                class="map__placemark"
                data-id="{{ dealerId }}"
                data-location="{{ item.location }}"
                data-city="{{ item.city | default('') | e('html_attr') }}"
                data-guarantee="{{ guaranteeVisible ? '1' : '0' }}"
                data-guarantee-title="{{ guaranteeTitle | e('html_attr') }}"
                data-bshm="{{ bshmVisible ? '1' : '0' }}"
                data-bshm-title="{{ bshmTitle | e('html_attr') }}"
                data-name="{{ item.name|default('')|e('html_attr') }}"
                data-address="{{ item.address|default('')|e('html_attr') }}"
                data-phones="{{ phones|json_encode|e('html_attr') }}"
                data-site="{{ item.site.title|default(item.site|default(''))|e('html_attr') }}"
                data-site-href="{{ item.site.href|default(item.site_href|default(''))|e('html_attr') }}">
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% if renderDealerItems is not empty %}
      <div class="section__item cards-wrap">
        {% for item in renderDealerItems %}
          {% if not onlyMappedCards or (item.location is defined and item.location) %}
            {% set dealerId = item.id | default(loop.index) %}
            {% set guaranteeData = item.guarantee | default({}) %}
            {% set bshmData = item.bshm | default({}) %}
            {% set guaranteeVisible = guaranteeData.visible | default(false) %}
            {% set bshmVisible = bshmData.visible | default(false) %}
            <div
              class="section__subitem card-wrap js-dealer-card"
              data-id="{{ dealerId }}"
              data-city="{{ item.city | default('') | e('html_attr') }}"
              data-guarantee="{{ guaranteeVisible ? '1' : '0' }}"
              data-bshm="{{ bshmVisible ? '1' : '0' }}">
              {% include 'components/card-dealer.twig' with {'item': item} %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
