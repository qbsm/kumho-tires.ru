<section class="faq section">
  <div class="container-sm">
    <div class="section__item block-wrap">
      {% if data.heading is defined %}
        <div class="section__subitem heading-wrap items-center text-center">
          <span class="heading-accent" aria-hidden="true"></span>
          {% include 'components/heading.twig' with {'item': data.heading} %}
        </div>
      {% endif %}
      {% if data.items is defined and data.items is not empty %}
        <div class="section__subitem">
          {% include 'components/accordion.twig' with {'items': data.items, 'accordion_id': 'faq'} %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
