{% set name = item.item.name | default(item.item.code | default('')) %}
{% set href = item.slug is defined and item.slug ? url('/tires/' ~ item.slug) : null %}

<a{% if href %} href="{{ href }}"{% endif %} class="card-tire"{{ href ? '' : ' role="group"' }} style="color:inherit;text-decoration:none">
  <div class="card__item title-wrap">
    <span class="card__title font-2 weight-600">{{ item.item.code }}</span>
  </div>
  {# Подпись производителя («Зимняя шина класса UHP») говорит покупателю больше, чем имя линейки #}
  {% set cardCaption = item.official.tagline | default(item.item.caption) | default(item.item.series) | default('') %}
  {% if cardCaption %}
    <div class="card__item desc-wrap">
      <span class="card__desc">{{ cardCaption }}</span>
    </div>
  {% endif %}
  {% if item.item.frame is defined and item.item.frame %}
    <div class="card__item frame-wrap">
      <span class="card__frame">{{ item.item.frame }}</span>
    </div>
  {% endif %}
{% set tireImage = null %}
  {% for angleKey in ['30deg', 'front', 'side'] %}
    {% if not tireImage and item.images[angleKey] is defined %}
      {% set tireImage = item.images[angleKey] %}
    {% endif %}
  {% endfor %}
  {% if not tireImage and item.image is defined %}
    {% set tireImage = item.image %}
  {% endif %}
  {% set imageAlt = tireImage and tireImage.alt is defined and tireImage.alt
    ? tireImage.alt
    : (name ? name ~ ', ракурс 30°' : '') %}
  {% if item.item.logo is defined and item.item.logo %}
    <div class="card-tire__logo-wrap">
      <img
        src="{{ item.item.logo }}"
        alt="{{ item.item.series|default('') }}"
        class="card-tire__series-logo"
        loading="lazy"
      >
    </div>
  {% endif %}
  <div class="card-tire__img-wrap">
    {% if tireImage %}
      {% include 'components/picture.twig' with {
        image: tireImage,
        alt: imageAlt,
        class: 'card-tire__img img-responsive',
        sizes_preset: 'card',
        loading: 'lazy',
        width: 400,
        height: 400
      } %}
    {% endif %}
  </div>
</a>
