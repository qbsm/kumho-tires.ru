<header class="header js-header" itemscope itemtype="https://schema.org/Organization">
  <div class="section__item block-wrap">
    <div class="section__subitem logo-wrap">
      <a href="/" class="link header__logo" itemprop="url">
        <img src="{{ url(global.logo.vertical.black.src|default('data/img/ui/logos/dealer-brand-logo-color-2.svg')) }}" alt="{{ global.logo.vertical.black.alt|default('Logo') }}" itemprop="logo" width="852" height="75">
      </a>
    </div>
    <nav class="section__subitem nav-wrap" aria-label="Основное меню">
      {% set pageKey = pageData.name|default(page_id|default('')) %}
      {% for item in global.nav[lang_code].items %}
        {% if item.visible is not defined or item.visible %}
        {% set itemHref = item.href|default('/') %}
        {% set normalizedItemHref = itemHref|trim('/') %}
        {% set isActive = false %}
        {% if normalizedItemHref == '' %}
          {% set isActive = pageKey == 'index' %}
        {% elseif item.active_for is defined and pageKey in item.active_for %}
          {% set isActive = true %}
        {% else %}
          {% set isActive = pageKey == normalizedItemHref %}
        {% endif %}
        {% set hasSubmenu = item.children is defined and item.children is not empty %}
        <div class="section__inner nav-link-wrap{{ hasSubmenu ? ' has-submenu' : '' }}">
          <a href="{{ url(itemHref) }}" class="link color-2 underline-center header__nav-link{{ isActive ? ' active' : '' }}"{{ hasSubmenu ? ' aria-haspopup="true"' : '' }}>{{ item.title }}</a>
          {% if hasSubmenu %}
            <div class="header__submenu">
              <div class="header__submenu-inner">
                <div class="header__submenu-groups">
                  {% for group in item.children %}
                    <div class="header__submenu-group">
                      {% if group.group is defined and group.group %}
                        <span class="header__submenu-title uppercase">{{ group.group }}</span>
                      {% endif %}
                      <div class="header__submenu-list">
                        {% for sub in group.items | default([]) %}
                          <a href="{{ url(sub.href) }}" class="link header__submenu-link">{{ sub.title }}</a>
                        {% endfor %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
                {% if item.featured is defined and item.featured %}
                  <a href="{{ url(item.featured.href) }}" class="link header__submenu-featured">
                    <span class="header__submenu-featured-title">{{ item.featured.title }}</span>
                    {% if item.featured.note is defined and item.featured.note %}
                      <span class="header__submenu-featured-note">{{ item.featured.note }}</span>
                    {% endif %}
                  </a>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="section__subitem burger-icon-wrap">
      {% include 'components/burger-icon.twig' %}
    </div>
    <div class="section__subitem burger-menu-wrap">
      {% include 'components/burger-menu.twig' with {
        items: global.nav[lang_code].items
      } %}
    </div>
  </div>
</header>